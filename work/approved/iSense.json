  "use_cases": [
    {
      "title": "Energy Monitoring & Power Management",
      "desc": "Ideal for monitoring electrical panels, DG sets, solar systems, utility meters, and RTUs using RS485/RS232 and 4-20mA transducer interfaces for real-time energy analytics and cloud data transmission."
    },
    {
      "title": "Process Automation & Industrial Control",
      "desc": "Can be deployed in manufacturing plants to integrate PLCs, sensors, relays, and field devices through RS485, DI/DO, and analog I/O for automated process control and predictive maintenance."
    },
    {
      "title": "Smart Infrastructure & Remote Asset Intelligence",
      "desc": "Suitable for smart buildings, water treatment plants, telecom shelters, agricultural systems, and remote field assets requiring field-level monitoring, MQTT/Modbus communication, and centralized remote management over cellular connectivity."
    }
  ],
