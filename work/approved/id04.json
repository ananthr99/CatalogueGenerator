    {
      "title": "Remote Industrial Equipment Monitoring",
      "desc": "Connects industrial machinery and field equipment to centralized monitoring systems, providing real-time visibility into operating conditions and performance. This allows teams to detect equipment abnormalities, troubleshoot issues remotely, and reduce unplanned downtime."
    },
    {
      "title": "Smart ATM & Kiosk Networking",
      "desc": "Provides secure and dependable network connectivity for ATMs and self-service kiosks, ensuring consistent access to banking and digital services. It supports real-time transaction processing, remote monitoring, and uninterrupted service delivery across distributed locations."
    },
    {
      "title": "Fleet & Mobile Asset Connectivity",
      "desc": "Keeps vehicles and mobile assets connected to central systems through reliable wireless communication, even while on the move. This enables real-time asset tracking, remote data access, and better coordination of fleet operations."
    }
