  "use_cases": [
    {
      "title": "Multi-WAN Failover",
      "desc": "Ensures uninterrupted internet connectivity by automatically switching to an alternate WAN connection whenever the primary link fails. This keeps business operations running with minimal downtime and without manual intervention."
    },
    {
      "title": "Secure Remote Infrastructure Access (Branch-to-HQ VPN)",
      "desc": "Establishes secure, encrypted VPN connections between branch offices and headquarters, allowing employees to access central applications, servers, and business resources remotely while keeping sensitive data protected."
    },
    {
      "title": "Industrial Control & Edge IoT Gateway",
      "desc": "Connects industrial equipment, sensors, and control systems to central networks, enabling reliable data collection and communication across the facility. It also supports edge-level processing for faster insights, monitoring, and operational control."
    },
    {
      "title": "High-Reliability Retail / ATM Broadband Bonding",
      "desc": "Combines multiple broadband connections to deliver higher bandwidth and dependable connectivity for retail outlets and ATMs. If one link experiences disruption, the remaining connections help maintain uninterrupted transactions and critical services."
    }
