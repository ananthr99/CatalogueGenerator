  "use_cases": [
    {
      "title": "Primary WAN Failover for Retail & Branch Offices",
      "desc": "Ideal for ensuring uninterrupted internet connectivity in retail stores and branch offices by automatically switching to a backup 4G/5G network when the primary WAN connection fails, maintaining seamless POS transactions, cloud access, and business operations."
    },
    {
      "title": "Remote SCADA/Industrial Site Connectivity",
      "desc": "Connecting remote industrial equipment, PLCs, RTUs, and SCADA systems over secure 4G/5G networks, enabling real-time data acquisition, remote monitoring, equipment control, and reliable communication between industrial sites and centralized control systems."
    },
    {
      "title": "Fleet of Distributed IoT/Metering Gateways with Centralized Management",
      "desc": "Deploying and managing multiple IoT and metering gateways across geographically distributed locations, enabling centralized device monitoring, remote configuration, firmware updates, and real-time data collection for efficient operations and maintenance."
    }
