    {
      "title": "Remote Sensor & Transducer Data to Cloud",
      "desc": "Ideal for connecting Transducers having 4-20mA output and data should be published to remote server using HTTPs/MQTTs communication."
    },
    {
      "title": "Drinking Water Treatment Plant Data to Remote Cloud SCADA",
      "desc": "Ideal for connecting clorine, Turbidity, TDS sensordata etc on AI interface to made available over VPN tunnel in Modbsu to SCADA for monitoring all the treatment paramaters."
    },
    {
      "title": "Industrial Alarm & Event Monitoring",
      "desc": "Suitable for factory alarms, pump stations, and equipment monitoring where digital I/O, pulse input, and SMS-based alerts are required for quick response and uptime management."
    }
